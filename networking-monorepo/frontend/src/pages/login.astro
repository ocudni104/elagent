---
import AuthLayout from "../layouts/AuthLayout.astro";
import { googleAuthActionPath } from "../lib/auth.js";
---
<AuthLayout title="Login · Westats">
  <h1>Login</h1>
  <p>Sign in with Google to connect your YouTube account.</p>

  <form id="google-auth-form" method="post" action={googleAuthActionPath}>
    <input type="hidden" name="deviceOs" value="" />
    <input type="hidden" name="deviceScreen" value="" />
    <button type="submit">Continue with Google</button>
  </form>

  <script is:inline>
    const form = document.getElementById("google-auth-form");

    if (form instanceof HTMLFormElement) {
      const deviceOsInput = form.elements.namedItem("deviceOs");
      const deviceScreenInput = form.elements.namedItem("deviceScreen");
      const platform =
        navigator.userAgentData?.platform || navigator.platform || navigator.userAgent;

      if (deviceOsInput instanceof HTMLInputElement) {
        deviceOsInput.value = platform;
      }

      if (deviceScreenInput instanceof HTMLInputElement) {
        deviceScreenInput.value =
          `${window.screen.width}x${window.screen.height}@${window.devicePixelRatio || 1}`;
      }
    }
  </script>
</AuthLayout>
